# Single source of truth for Docker Compose + backend + workers
# 1) Copy this file to .env
# 2) Fill in REQUIRED values
#
# IMPORTANT (VPS): choose ONE ingress mode
# - IP-only (no TLS): nginx (docker-compose.yml) -> frontend
# - Domain+TLS: caddy (docker-compose.vps.yml) -> frontend

# --- Common (shared by API and workers)
APP_ENV=development

DATABASE_URL=postgresql+psycopg://sdlp:sdlp@postgres:5432/sdlp
REDIS_URL=redis://redis:6379/0

# REQUIRED: rotate for production
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=corelms
JWT_ACCESS_TOKEN_MINUTES=60

ALLOW_PUBLIC_REGISTER=false
PASSWORD_MIN_LENGTH=8

# --- Public URL / cookies / CORS
# Set to your public origin (used in emails/links; should match what users type in browser)
# VPS IP-only example:  http://64.188.124.111
# Domain+TLS example:   https://lms.example.com
PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of allowed browser origins
# VPS IP-only example:  http://64.188.124.111
# Domain+TLS example:   https://lms.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# Cookies
# - IP-only (http): false
# - Domain+TLS (https): true
COOKIE_SECURE=false

# Optional (usually only needed for multi-subdomain setups)
COOKIE_DOMAIN=

# --- First admin on fresh DB (only if there is no admin yet)
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# --- Reverse proxy trust (critical for correct client IP behind nginx/caddy)
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=172.16.0.0/12,127.0.0.1

# --- Queues (RQ)
RQ_QUEUE_IMPORT=corelms_import
RQ_QUEUE_REGEN=corelms_regen
RQ_QUEUE_DEFAULT=corelms
RQ_QUEUE_CLEANUP=corelms_cleanup

RQ_WORKER_IMPORT_QUEUES=corelms_import
RQ_WORKER_REGEN_QUEUES=corelms_regen
RQ_WORKER_DEFAULT_QUEUES=corelms_cleanup,corelms

# --- S3 (REG.RU / any S3-compatible)
# For AWS S3 set S3_ENDPOINT_URL= (empty). For REG.RU S3 provide endpoint.
S3_ENDPOINT_URL=https://s3.regru.cloud

# Public endpoint for browser presigned PUT/GET (must be reachable from browser)
S3_PUBLIC_ENDPOINT_URL=https://s3.regru.cloud

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=corelms-content
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=path

# Presign TTLs
S3_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=900
S3_PRESIGN_UPLOAD_EXPIRES_SECONDS=3600
S3_PRESIGN_MULTIPART_PART_EXPIRES_SECONDS=3600

# Transport
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=5
S3_MAX_POOL_CONNECTIONS=50

# --- Uploads/import cleanup
UPLOADS_ADMIN_TTL_HOURS=6
UPLOADS_ADMIN_CLEANUP_INTERVAL_MINUTES=15
UPLOADS_ADMIN_MULTIPART_TTL_HOURS=12
UPLOADS_ADMIN_MULTIPART_MAX_ABORT=200

# --- LLM (optional)
LLM_PROVIDER_ORDER=openrouter

OPENROUTER_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=CoreLMS
OPENROUTER_TIMEOUT_CONNECT=3
OPENROUTER_TIMEOUT_READ=15
OPENROUTER_TIMEOUT_WRITE=15
OPENROUTER_TEMPERATURE=0.2

# --- Frontend (docker-compose build/runtime)
# For docker network usage keep backend service DNS name
NEXT_PUBLIC_API_BASE_URL=http://backend:8000
CORE_INTERNAL_API_BASE_URL=http://backend:8000