{$CADDY_DOMAIN} {
  encode zstd gzip

  request_body {
    max_size 26GB
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }

  # Authenticated PDFs must be embeddable by this same application only.
  @asset_stream path /api/backend/assets/*/stream
  @not_asset_stream not path /api/backend/assets/*/stream
  header @asset_stream >X-Frame-Options "SAMEORIGIN"
  header @not_asset_stream >X-Frame-Options "DENY"

  # Загрузка файлов идёт прямо в backend: Next.js ограничивает время приёма
  # запроса (~5 минут), из-за чего видео обрывалось ошибкой 502.
  handle /api/upload/* {
    uri strip_prefix /api/upload
    reverse_proxy backend:8000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 3600s
        write_timeout 3600s
      }
    }
  }

  # Next.js API routes must be handled by the frontend container.
  @next_api path /api/backend/* /api/auth/*
  handle @next_api {
    reverse_proxy frontend:3000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 3600s
        write_timeout 3600s
      }
    }
  }

  # Backend health endpoints can be proxied directly.
  @health path /health/*
  handle @health {
    reverse_proxy backend:8000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 60s
        write_timeout 60s
      }
    }
  }

  handle {
    reverse_proxy frontend:3000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 120s
        write_timeout 120s
      }
    }
  }
}
