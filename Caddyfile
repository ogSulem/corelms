{$CADDY_DOMAIN} {
  encode zstd gzip

  request_body {
    max_size 26GB
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }

  # Next.js API routes must be handled by the frontend container.
  @next_api path /api/backend/* /api/auth/*
  handle @next_api {
    reverse_proxy frontend:3000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 120s
        write_timeout 120s
      }
    }
  }

  # Backend health endpoints can be proxied directly.
  @health path /health/*
  handle @health {
    reverse_proxy backend:8000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 60s
        write_timeout 60s
      }
    }
  }

  handle {
    reverse_proxy frontend:3000 {
      header_up X-Real-IP {remote_host}
      transport http {
        dial_timeout 10s
        read_timeout 120s
        write_timeout 120s
      }
    }
  }
}
